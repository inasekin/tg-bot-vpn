# Ваш токен от BotFather
BOT_TOKEN=СЮДА_ВАШ_ТОКЕН
# Ваш Telegram ID
ADMIN_ID=ВАШ_ID

WG_SERVERS=nl,us

WG_SERVER_PUBLIC_KEY_NL=<публичный ключ ТЕКУЩЕГО NL AmneziaWG сервера>
WG_SERVER_ENDPOINT_NL=<IP_NL_сервера>:51820
WG_SERVER_SUBNET_NL=10.0.0.
# Параметры обфускации AmneziaWG (S1-S4, H1-H4) должны совпадать с awg-конфигом
# сервера. Значения по умолчанию — в src/config.py (AWG_DEFAULTS).
# Параметры AWG 3.x (HeaderProtectionKey, RandomTrailers, ContentPaddingAddition, тайминги)
# по умолчанию выключены: у модуля ядра открыты баги совместимости с клиентами
# (kernel-module issues #222, #226). Включать только вместе с сервером, например:
# WG_SERVER_HEADER_PROTECTION_KEY_NL=<ключ из wg0.conf>   (тогда H1..H4 = 1,2,3,4; S1-S4 >= 12)
# WG_SERVER_RANDOM_TRAILERS_NL=on                         (тогда S1 = S2 = S3 = S4)

# I1-I5 (CPS): мимикрия под QUIC/DNS перед рукопожатием — против DPI провайдера.
# Только клиентские, на сервере не нужны. Пример QUIC Initial (1200 байт) — лучше
# в паре с портом 443/udp. Значение в кавычках:
# WG_SERVER_I1_NL="<b 0xc30000000108><r 8><b 0x08><r 8><b 0x004496><r 1000><r 174>"
# Пример переопределения: WG_SERVER_H1_NL=1234567-1235567

WG_SERVER_PUBLIC_KEY_US=<публичный ключ ТЕКУЩЕГО US AmneziaWG сервера>
WG_SERVER_ENDPOINT_US=<IP_US_сервера>:51820
WG_SERVER_SUBNET_US=10.0.1.
WG_SERVER_SSH_HOST_US=<IP_US_сервера>
WG_SERVER_SSH_USER_US=root
WG_SERVER_SSH_KEY_US=/root/.ssh/bot_us_server
# Если US-сервер ещё на старой версии AmneziaWG, уберите новые параметры пустыми значениями:
# WG_SERVER_S3_US=
# WG_SERVER_S4_US=
# WG_SERVER_H1_US=1234567
# ...
