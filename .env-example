# Ваш токен от BotFather
BOT_TOKEN=СЮДА_ВАШ_ТОКЕН
# Ваш Telegram ID
ADMIN_ID=ВАШ_ID

WG_SERVERS=ru,us

WG_SERVER_PUBLIC_KEY_RU=<публичный ключ ТЕКУЩЕГО RU AmneziaWG сервера>
